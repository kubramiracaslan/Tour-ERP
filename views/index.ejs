<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Operasyon Yönetim Paneli</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <style>
        body { background-color: #f4f6f9; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .navbar { background: linear-gradient(135deg, #10b981, #059669); }
        .card { border: none; border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
        .status-badge { padding: 8px 14px; border-radius: 30px; font-weight: 600; font-size: 0.85rem; text-align: center; display: inline-block; white-space: nowrap; }
        .status-DONE { background-color: #d1fae5; color: #065f46; }
        .status-PENDING { background-color: #fef3c7; color: #92400e; }
        .status-MISSING { background-color: #fee2e2; color: #991b1b; }
        .table-responsive { background: white; border-radius: 15px; padding: 20px; overflow-x: auto; }
        .main-table th { white-space: nowrap; padding: 15px 10px; }
        .main-table td { padding: 18px 10px; vertical-align: middle; }
        .nested-table { background-color: #f8fafc; border-left: 5px solid #10b981; border-radius: 0 10px 10px 0; }
        .date-field { white-space: nowrap; min-width: 190px; }
        .tour-name-field { min-width: 200px; font-size: 1.05rem; }
        .nav-link.active { background-color: rgba(255,255,255,0.15) !important; border-radius: 8px; }
        .select2-container--default .select2-selection--multiple { border: 1px solid #dee2e6; border-radius: 0.375rem; padding: 4px; }
        .restaurant-chip-sm { display: flex; justify-content: space-between; align-items: center; gap: 6px; padding: 2px 6px; border-radius: 6px; background: #eef2f7; margin-bottom: 3px; font-size: 0.72rem; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark p-3 text-white shadow">
        <div class="container-fluid">
            <span class="navbar-brand fw-bold fs-3"><i class="fa-solid fa-map-location-dot me-2"></i> Operasyon Takip Sistemi</span>
            <div class="collapse navbar-collapse" id="navbarNav">
                <div class="navbar-nav ms-4 gap-2">
                    <a href="/" class="nav-link fw-bold px-3 text-white <%= (typeof page_path !== 'undefined' && page_path === '/') ? 'active' : '' %>"><i class="fa-solid fa-list-check me-1"></i> Aktif Turlar</a>
                    <a href="/tour-demands" class="nav-link fw-bold px-3 text-white <%= (typeof page_path !== 'undefined' && page_path === '/tour-demands') ? 'active' : '' %>"><i class="fa-solid fa-table-list me-1"></i> Talep Takip (CRM)</a>
                    <a href="/management" class="nav-link fw-bold px-3 text-white <%= (typeof page_path !== 'undefined' && page_path === '/management') ? 'active' : '' %>"><i class="fa-solid fa-plus me-1"></i> Temel Tanımlamalar</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="container-fluid my-4 px-4">
        <% if (typeof guideConflict !== 'undefined' && guideConflict) { %>
            <div class="alert alert-danger fw-semibold shadow-sm">
                <i class="fa-solid fa-triangle-exclamation me-2"></i><%= guideConflict %>
            </div>
        <% } %>
        <div class="card p-4 mb-4 shadow-sm">
            <form action="/" method="GET" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-bold text-secondary">Yıl Seçin</label>
                    <select name="year" class="form-select fw-semibold py-2">
                        <option value="">Tüm Yıllar</option>
                        <option value="2026" <%= String(selectedYear) === '2026' ? 'selected' : '' %>>2026</option>
                        <option value="2027" <%= String(selectedYear) === '2027' ? 'selected' : '' %>>2027</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold text-secondary">Ay Seçin</label>
                    <select name="month" class="form-select fw-semibold py-2">
                        <option value="">Tüm Aylar</option>
                        <% const months = ["Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran", "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık"]; %>
                        <% months.forEach((m, index) => { %> <option value="<%= index + 1 %>" <%= (selectedMonth && Number(selectedMonth) === (index + 1)) ? 'selected' : '' %>><%= m %></option> <% }) %>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-success w-100 fw-bold py-2"><i class="fa-solid fa-filter me-1"></i> Filtrele</button>
                    <% if (selectedYear || selectedMonth) { %> <a href="/" class="btn btn-secondary fw-bold py-2"><i class="fa-solid fa-filter-circle-xmark"></i></a> <% } %>
                </div>
                <div class="col-md-3 text-end">
                    <button type="button" class="btn btn-dark fw-bold py-2 px-4 w-100" data-bs-toggle="modal" data-bs-target="#newTourModal"><i class="fa-solid fa-folder-plus me-1"></i> Yeni Tur Oluştur</button>
                </div>
            </form>
        </div>

        <div class="card shadow-sm p-3">
            <h4 class="fw-bold mb-4 text-dark px-2"><i class="fa-solid fa-list-check me-2 text-success"></i> Aktif Tur Operasyonları</h4>
            <div class="table-responsive">
                <table class="table table-hover main-table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Tur Adı</th> <th>Operasyon Tarihleri</th> <th>Acente (Müşteri)</th> <th>Ana Rehber</th> <th>Ulaşım / Otobüs</th> <th>Gelen Ödeme (Acente)</th> <th>Giden Ödemeler</th> <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(operations.length === 0) { %>
                            <tr><td colspan="8" class="text-center py-5 text-muted fw-semibold">Tanımlı tur bulunamadı.</td></tr>
                        <% } %>
                        <% operations.forEach(op => { %>
                            <tr class="fw-semibold">
                                <td class="text-primary tour-name-field"><%= op.operation_name %></td>
                                <td class="date-field">
                                    <span class="badge bg-secondary p-2 fw-semibold">
                                        <i class="fa-regular fa-calendar me-1"></i>
                                        <%= op.start_date ? op.start_date.toISOString().split('T')[0] : 'N/A' %> / <%= op.end_date ? op.end_date.toISOString().split('T')[0] : 'N/A' %>
                                    </span>
                                </td>
                                <td><i class="fa-solid fa-building text-secondary me-1"></i> <%= op.agency_name || 'Acente Yok' %></td>
                                <td><i class="fa-solid fa-user-tie text-secondary me-1"></i> <%= op.guide_name || 'Atanmadı' %></td>
                                <td><span class="status-badge status-<%= op.transport_status %>"><%= op.transport_status === 'DONE' ? 'Tamamlandı' : 'Tamamlanmadı' %></span></td>
                                <td><span class="status-badge status-<%= op.payment_received %>"><%= op.payment_received === 'DONE' ? 'Alındı' : 'Tamamlanmadı' %></span></td>
                                <td><span class="status-badge status-<%= op.payment_paid %>"><%= op.payment_paid === 'DONE' ? 'Ödendi' : 'Tamamlanmadı' %></span></td>
                                <td>
                                    <div class="d-flex gap-2 justify-content-center">
                                        <button class="btn btn-sm btn-outline-success fw-bold py-2 text-nowrap" type="button" data-bs-toggle="collapse" data-bs-target="#details-<%= op.id %>"><i class="fa-solid fa-eye me-1"></i> Tur Detayları (<%= op.city_count %>)</button>
                                        <a href="/tour-operation/<%= op.id %>" class="btn btn-sm btn-primary fw-bold py-2 text-nowrap"><i class="fa-solid fa-sliders me-1"></i> Operasyon Yönetimi</a>
                                    </div>
                                </td>
                            </tr>

                            <tr class="collapse" id="details-<%= op.id %>">
                                <td colspan="8" class="p-0">
                                    <div class="p-4 nested-table m-2 shadow-inner">
                                        <h6 class="fw-bold text-success mb-3"><i class="fa-solid fa-city me-2"></i> Şehir Bazlı Operasyon Adımları Özet Kontrolü:</h6>
                                        <table class="table table-sm table-bordered bg-white align-middle text-center m-0">
                                            <thead class="table-secondary">
                                                <tr>
                                                    <th class="text-start ps-3">Şehir Adı</th> <th>Otel Bilgisi & Durum</th> <th>Restoranlar & Durum</th> <th>Ana Lider (Leader)</th> <th>Yerel Şehir Rehberi</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if(!op.cities || op.cities.length === 0 || op.cities[0].city_name === null) { %>
                                                    <tr><td colspan="5" class="text-muted text-center py-3">Bu tura henüz bir şehir operasyon adımı eklenmedi.</td></tr>
                                                <% } else { %>
                                                    <% op.cities.forEach(c => { %>
                                                        <tr class="fw-semibold">
                                                            <td class="text-start ps-3 text-dark fw-bold"><%= c.city_name %></td>

                                                            <!-- OTEL: tekil -->
                                                            <td>
                                                                <div class="text-start ps-2">
                                                                    <small class="d-block text-secondary fw-bold"><%= c.hotel_name || 'Seçilmedi' %></small>
                                                                    <span class="status-badge status-<%= c.hotel_name ? c.hotel_status : 'MISSING' %>" style="font-size: 0.75rem; padding: 3px 8px;"><%= c.hotel_name ? (c.hotel_status === 'DONE' ? 'Tamamlandı' : 'Tamamlanmadı') : 'Seçilmedi' %></span>
                                                                </div>
                                                            </td>

                                                            <!-- RESTORANLAR: çoklu, her biri kendi durumuyla -->
                                                            <td>
                                                                <div class="text-start ps-2">
                                                                    <% if (!c.restaurants || c.restaurants.length === 0) { %>
                                                                        <span class="status-badge status-MISSING" style="font-size: 0.75rem; padding: 3px 8px;">Seçilmedi</span>
                                                                    <% } else { %>
                                                                        <% c.restaurants.forEach(r => { %>
                                                                            <div class="restaurant-chip-sm">
                                                                                <span class="fw-bold text-secondary"><%= r.restaurant_name %></span>
                                                                                <span class="status-badge status-<%= r.status %>" style="font-size: 0.68rem; padding: 2px 6px;"><%= r.status === 'DONE' ? 'Tamamlandı' : 'Tamamlanmadı' %></span>
                                                                            </div>
                                                                        <% }) %>
                                                                    <% } %>
                                                                </div>
                                                            </td>

                                                            <td>
                                                                <div class="text-start ps-2">
                                                                    <small class="d-block text-secondary fw-bold"><%= c.general_guide_name || 'Atanmadı' %></small>
                                                                    <span class="status-badge status-<%= c.general_guide_name ? c.general_guide_status : 'PENDING' %>" style="font-size: 0.75rem; padding: 3px 8px;">
                                                                        <%= c.general_guide_name ? (c.general_guide_status === 'DONE' ? 'Tamamlandı' : 'Tamamlanmadı') : 'Atanmadı' %>
                                                                    </span>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="text-start ps-2">
                                                                    <small class="d-block text-secondary fw-bold"><%= c.local_guide_name || 'Atanmadı' %></small>
                                                                    <span class="status-badge status-<%= c.local_guide_name ? c.local_guide_status : 'PENDING' %>" style="font-size: 0.75rem; padding: 3px 8px;">
                                                                        <%= c.local_guide_name ? (c.local_guide_status === 'DONE' ? 'Tamamlandı' : 'Tamamlanmadı') : 'Atanmadı' %>
                                                                    </span>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    <% }) %>
                                                <% } %>
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="modal fade" id="newTourModal" tabindex="-1" aria-labelledby="newTourModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" style="border-radius: 15px;">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold" id="newTourModalLabel"><i class="fa-solid fa-plane-departure me-2 text-success"></i> Yeni Tur Operasyon Kaydı</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/add-tour" method="POST" id="newTourForm">
                    <div class="modal-body p-4">
                        <div id="newTourModalError" class="alert alert-danger fw-semibold d-none mb-3">
                            <i class="fa-solid fa-triangle-exclamation me-2"></i><span id="newTourModalErrorText"></span>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-12"> <label class="form-label fw-bold">Tur / Operasyon Adı</label> <input type="text" name="tour_name" class="form-control" placeholder="Örn: Balkan Turu" required> </div>
                            <div class="col-md-6"> <label class="form-label fw-bold">Başlangıç Tarihi</label> <input type="date" name="start_date" class="form-control" required> </div>
                            <div class="col-md-6"> <label class="form-label fw-bold">Bitiş Tarihi</label> <input type="date" name="end_date" class="form-control" required> </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Acente (Müşteri)</label>
                                <select name="agency_id" class="form-select">
                                    <option value="">-- Acente Seçin --</option>
                                    <% if (typeof agencies !== 'undefined') { %> <% agencies.forEach(a => { %> <option value="<%= a.id %>"><%= a.agency_name %></option> <% }) %> <% } %>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Ana Tur Rehberi</label>
                                <select name="main_guide_id" class="form-select">
                                    <option value="">-- Rehber Seçin --</option>
                                    <% if (typeof guides !== 'undefined') { %> <% guides.forEach(g => { %> <option value="<%= g.id %>"><%= g.guide_name %></option> <% }) %> <% } %>
                                </select>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label fw-bold text-success"><i class="fa-solid fa-city me-1"></i> Tur Rotaları / Şehirler (Çoklu Seçim)</label>
                                <select name="city_ids[]" class="form-select select2-cities" multiple="multiple" style="width: 100%;">
                                    <% if (typeof cities !== 'undefined') { %> <% cities.forEach(c => { %> <option value="<%= c.id %>">🏙️ <%= c.city_name %></option> <% }) %> <% } %>
                                </select>
                            </div>
                            <div class="col-md-4"> <label class="form-label fw-bold">Ulaşım / Bilet Durumu</label> <select name="transport_status" class="form-select"><option value="PENDING">Tamamlanmadı</option><option value="DONE">Tamamlandı</option></select> </div>
                            <div class="col-md-4"> <label class="form-label fw-bold">Gelen Ödeme</label> <select name="payment_received" class="form-select"><option value="PENDING">Tamamlanmadı</option><option value="DONE">Alındı</option></select> </div>
                            <div class="col-md-4"> <label class="form-label fw-bold">Giden Ödeme (Maliyetler)</label> <select name="payment_paid" class="form-select"><option value="PENDING">Tamamlanmadı</option><option value="DONE">Ödendi</option></select> </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Kapat</button>
                        <button type="submit" class="btn btn-success fw-bold px-4">Turu Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#newTourModal').on('shown.bs.modal', function () {
                $('.select2-cities').select2({ dropdownParent: $('#newTourModal'), placeholder: "🏙️ Şehir ismini yazarak arayın...", allowClear: true, width: '100%' });
            });
        });

        // ---------------------------------------------------------------
        // "Yeni Tur Oluştur" formu: normal submit yerine önce AJAX ile
        // rehber çakışmasını kontrol ediyoruz. Çakışma varsa modal AÇIK
        // kalır, hiçbir alan sıfırlanmaz, sadece içeride uyarı gösterilir.
        // Çakışma yoksa form normal şekilde (sayfa yenilenerek) gönderilir.
        // ---------------------------------------------------------------
        document.addEventListener('DOMContentLoaded', function () {
            const newTourForm = document.getElementById('newTourForm');
            const errorBox = document.getElementById('newTourModalError');
            const errorText = document.getElementById('newTourModalErrorText');

            if (!newTourForm) return;

            function showModalError(message) {
                errorText.textContent = message;
                errorBox.classList.remove('d-none');
            }

            function hideModalError() {
                errorBox.classList.add('d-none');
                errorText.textContent = '';
            }

            newTourForm.addEventListener('submit', async function (e) {
                e.preventDefault();
                hideModalError();

                const mainGuideId = newTourForm.main_guide_id.value;
                const startDate = newTourForm.start_date.value;
                const endDate = newTourForm.end_date.value;

                if (mainGuideId && startDate && endDate) {
                    try {
                        const res = await fetch(`/api/guide-conflict?guide_id=${encodeURIComponent(mainGuideId)}&start_date=${encodeURIComponent(startDate)}&end_date=${encodeURIComponent(endDate)}`);
                        const data = await res.json();

                        if (data.conflict) {
                            showModalError(data.message);
                            return; // modal açık kalır, form gönderilmez
                        }
                    } catch (err) {
                        console.error('Rehber çakışma kontrolü yapılamadı, kayıt yine de deneniyor:', err);
                        // Ağ/istek hatasında engellemiyoruz; sunucu tarafı /add-tour
                        // içinde zaten aynı kontrolü son bir güvenlik katmanı olarak yapıyor.
                    }
                }

                // Çakışma yoksa (ya da kontrol edilemediyse) formu native şekilde gönder
                HTMLFormElement.prototype.submit.call(newTourForm);
            });
        });
    </script>
</body>
</html>
