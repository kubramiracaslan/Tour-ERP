<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OperationManagement - Definitions</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .nav-link.active { background-color: rgba(255,255,255,0.15) !important; border-radius: 8px; }
    </style>
</head>
<body class="bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark p-3 text-white shadow" style="background: linear-gradient(135deg, #10b981, #059669);">
        <div class="container-fluid">
            <span class="navbar-brand fw-bold fs-3"><i class="fa-solid fa-map-location-dot me-2"></i> Operasyon Takip Sistemi</span>
            <div class="collapse navbar-collapse" id="navbarNav">
                <div class="navbar-nav ms-4 gap-2">
                    <a href="/" class="nav-link fw-bold px-3 text-white <%= (typeof page_path !== 'undefined' && page_path === '/') ? 'active' : '' %>"><i class="fa-solid fa-list-check me-1"></i> Aktif Turlar</a>
                    <a href="/tour-demands" class="nav-link fw-bold px-3 text-white <%= (typeof page_path !== 'undefined' && page_path === '/tour-demands') ? 'active' : '' %>"><i class="fa-solid fa-table-list me-1"></i> Talep Takip (CRM)</a>
                    <a href="/calendar" class="nav-link fw-bold px-3 text-white <%= (typeof page_path !== 'undefined' && page_path === '/calendar') ? 'active' : '' %>"><i class="fa-solid fa-calendar-days me-1"></i> Takvim</a>
                    <% if (typeof currentUserRole !== 'undefined' && currentUserRole === 'admin') { %>
                        <a href="/management" class="nav-link fw-bold px-3 text-white <%= (typeof page_path !== 'undefined' && page_path === '/management') ? 'active' : '' %>"><i class="fa-solid fa-plus me-1"></i> Temel Tanımlamalar</a>
                    <% } %>
                    <% if (typeof currentUserRole !== 'undefined' && currentUserRole === 'admin') { %>
                        <a href="/users" class="nav-link fw-bold px-3 text-white <%= (typeof page_path !== 'undefined' && page_path === '/users') ? 'active' : '' %>"><i class="fa-solid fa-user-gear me-1"></i> Kullanıcılar</a>
                    <% } %>
                </div>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <span class="text-white small fw-semibold"><i class="fa-solid fa-circle-user me-1"></i><%= typeof currentUser !== 'undefined' && currentUser ? currentUser : '' %></span>
                    <form action="/logout" method="POST" class="m-0">
                        <button type="submit" class="btn btn-sm btn-outline-light fw-bold"><i class="fa-solid fa-right-from-bracket me-1"></i> Çıkış</button>
                    </form>
                </div>
            </div>
        </div>
    </nav>

    <div class="container mb-5">
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger fw-semibold">
                <% if (error === 'invalid_country_name') { %> Lütfen geçerli bir ülke adı giriniz.
                <% } else if (error === 'invalid_city') { %> Lütfen geçerli bir şehir adı ve ülke seçiniz.
                <% } else if (error === 'invalid_guide_name') { %> Lütfen geçerli bir rehber adı giriniz.
                <% } else if (error === 'invalid_agency_name') { %> Lütfen geçerli bir acente adı giriniz.
                <% } else { %> Girdiğiniz bilgilerde bir sorun var, lütfen kontrol edin.
                <% } %>
            </div>
        <% } %>
        <div class="row g-4">

            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white fw-bold py-3">📍 Add New Country</div>
                    <div class="card-body p-4">
                        <form action="/add-country" method="POST">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Country Name</label>
                                <input type="text" name="country_name" class="form-control" placeholder="e.g. Italy" required>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 py-2">Save Country</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white fw-bold py-3">🏙️ Add New City</div>
                    <div class="card-body p-4">
                        <form action="/add-city" method="POST">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Select Country</label>
                                <select name="country_id" class="form-select" required>
                                    <option value="">-- Choose Country --</option>
                                    <% countries.forEach(c => { %>
                                        <option value="<%= c.id %>"><%= c.country_name %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">City Name</label>
                                <input type="text" name="city_name" class="form-control" placeholder="e.g. Rome" required>
                            </div>
                            <button type="submit" class="btn btn-success w-100 py-2">Save City</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white fw-bold py-3">🏢 Add New Agency</div>
                    <div class="card-body p-4">
                        <form action="/add-agency" method="POST">
                            <input type="hidden" name="redirect_to" value="/management">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Agency Name</label>
                                <input type="text" name="agency_name" class="form-control" placeholder="e.g. Global Travel LLC" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Phone Number</label>
                                <input type="tel" name="phone" class="form-control" placeholder="e.g. +90 532 XXX XX XX">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Email Address</label>
                                <input type="email" name="email" class="form-control" placeholder="e.g. info@agency.com">
                            </div>
                            <button type="submit" class="btn btn-info text-white w-100 py-2">Save Agency</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white fw-bold py-3">👤 Add New Guide</div>
                    <div class="card-body p-4">
                        <form action="/add-guide" method="POST">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Guide Name</label>
                                <input type="text" name="guide_name" class="form-control" placeholder="e.g. John Doe" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Phone Number</label>
                                <input type="text" name="phone" class="form-control" placeholder="e.g. +90...">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Email Address</label>
                                <input type="email" name="email" class="form-control" placeholder="e.g. guide@example.com">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Guide Type</label>
                                <select name="guide_type" class="form-select">
                                    <option value="GENERAL">General Tour Leader</option>
                                    <option value="LOCAL">Local City Guide</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-warning text-white w-100 py-2">Save Guide</button>
                        </form>
                    </div>
                </div>
            </div>

        </div>

        <!-- ACENTELER LİSTESİ (düzenleme için) -->
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-dark text-white fw-bold py-3">📋 Acenteler</div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle m-0">
                        <thead class="table-light">
                            <tr>
                                <th>Acente Adı</th>
                                <th>Telefon</th>
                                <th>Email</th>
                                <th class="text-center">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (agencies.length === 0) { %>
                                <tr><td colspan="4" class="text-center py-4 text-muted fw-semibold">Henüz acente eklenmedi.</td></tr>
                            <% } %>
                            <% agencies.forEach(a => { %>
                                <tr class="fw-semibold">
                                    <td><%= a.agency_name %></td>
                                    <td><small class="text-muted"><%= a.phone || '-' %></small></td>
                                    <td><small class="text-muted"><%= a.email || '-' %></small></td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-primary fw-bold edit-agency-btn"
                                                data-bs-toggle="modal" data-bs-target="#editAgencyModal"
                                                data-id="<%= a.id %>"
                                                data-name="<%= a.agency_name %>"
                                                data-phone="<%= a.phone || '' %>"
                                                data-email="<%= a.email || '' %>">
                                            <i class="fa-solid fa-pen-to-square"></i> Düzenle
                                        </button>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Acente Düzenleme Modalı -->
    <div class="modal fade" id="editAgencyModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 15px;">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-building me-2"></i> Acenteyi Düzenle</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="editAgencyForm" method="POST">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Acente Adı</label>
                            <input type="text" name="agency_name" id="edit-agency-name" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Telefon</label>
                            <input type="tel" name="phone" id="edit-agency-phone" class="form-control">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Email</label>
                            <input type="email" name="email" id="edit-agency-email" class="form-control">
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Kapat</button>
                        <button type="submit" class="btn btn-primary fw-bold px-4">Değişiklikleri Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.edit-agency-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    document.getElementById('editAgencyForm').action = '/update-agency/' + btn.getAttribute('data-id');
                    document.getElementById('edit-agency-name').value = btn.getAttribute('data-name') || '';
                    document.getElementById('edit-agency-phone').value = btn.getAttribute('data-phone') || '';
                    document.getElementById('edit-agency-email').value = btn.getAttribute('data-email') || '';
                });
            });
        });
    </script>

</body>
</html>
