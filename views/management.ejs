<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OperationManagement - Definitions</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .nav-link.active { background-color: rgba(255,255,255,0.15) !important; border-radius: 8px; }
    </style>
</head>
<body class="bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark p-3 text-white shadow" style="background: linear-gradient(135deg, #10b981, #059669);">
        <div class="container-fluid">
            <span class="navbar-brand fw-bold fs-3"><i class="fa-solid fa-map-location-dot me-2"></i> Operasyon Takip Sistemi</span>
            <div class="collapse navbar-collapse" id="navbarNav">
                <div class="navbar-nav ms-4 gap-2">
                    <a href="/" class="nav-link fw-bold px-3 text-white <%= (typeof page_path !== 'undefined' && page_path === '/') ? 'active' : '' %>"><i class="fa-solid fa-list-check me-1"></i> Aktif Turlar</a>
                    <a href="/tour-demands" class="nav-link fw-bold px-3 text-white <%= (typeof page_path !== 'undefined' && page_path === '/tour-demands') ? 'active' : '' %>"><i class="fa-solid fa-table-list me-1"></i> Talep Takip (CRM)</a>
                    <a href="/calendar" class="nav-link fw-bold px-3 text-white <%= (typeof page_path !== 'undefined' && page_path === '/calendar') ? 'active' : '' %>"><i class="fa-solid fa-calendar-days me-1"></i> Takvim</a>
                    <a href="/management" class="nav-link fw-bold px-3 text-white <%= (typeof page_path !== 'undefined' && page_path === '/management') ? 'active' : '' %>"><i class="fa-solid fa-plus me-1"></i> Temel Tanımlamalar</a>
                    <% if (typeof currentUserRole !== 'undefined' && currentUserRole === 'admin') { %>
                        <a href="/users" class="nav-link fw-bold px-3 text-white <%= (typeof page_path !== 'undefined' && page_path === '/users') ? 'active' : '' %>"><i class="fa-solid fa-user-gear me-1"></i> Kullanıcılar</a>
                    <% } %>
                </div>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <span class="text-white small fw-semibold"><i class="fa-solid fa-circle-user me-1"></i><%= typeof currentUser !== 'undefined' && currentUser ? currentUser : '' %></span>
                    <form action="/logout" method="POST" class="m-0">
                        <button type="submit" class="btn btn-sm btn-outline-light fw-bold"><i class="fa-solid fa-right-from-bracket me-1"></i> Çıkış</button>
                    </form>
                </div>
            </div>
        </div>
    </nav>

    <div class="container mb-5">
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger fw-semibold">
                <% if (error === 'invalid_country_name') { %> Lütfen geçerli bir ülke adı giriniz.
                <% } else if (error === 'invalid_city') { %> Lütfen geçerli bir şehir adı ve ülke seçiniz.
                <% } else if (error === 'invalid_guide_name') { %> Lütfen geçerli bir rehber adı giriniz.
                <% } else { %> Girdiğiniz bilgilerde bir sorun var, lütfen kontrol edin.
                <% } %>
            </div>
        <% } %>
        <div class="row g-4">

            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white fw-bold py-3">📍 Ülke Ekle </div>
                    <div class="card-body p-4">
                        <form action="/add-country" method="POST">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Ülke Adı</label>
                                <input type="text" name="country_name" class="form-control" placeholder="Ülke Adı" required>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 py-2">Kaydet</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white fw-bold py-3">🏙️ Şehir Ekle</div>
                    <div class="card-body p-4">
                        <form action="/add-city" method="POST">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Ülke Seç</label>
                                <select name="country_id" class="form-select" required>
                                    <option value="">Ülke Seç</option>
                                    <% countries.forEach(c => { %>
                                        <option value="<%= c.id %>"><%= c.country_name %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Şehir Adı</label>
                                <input type="text" name="city_name" class="form-control" placeholder="Şehir Adı" required>
                            </div>
                            <button type="submit" class="btn btn-success w-100 py-2">Kaydet</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white fw-bold py-3">🏢 Acente Ekle</div>
                    <div class="card-body p-4">
                        <form action="/add-agency" method="POST">
                            <input type="hidden" name="redirect_to" value="/management">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Acente Adı</label>
                                <input type="text" name="agency_name" class="form-control" placeholder="Acente Adı" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Telefon Numarası</label>
                                <input type="tel" name="phone" class="form-control" placeholder="Telefon Numarası">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Email Adresi</label>
                                <input type="email" name="email" class="form-control" placeholder="Email Adresi">
                            </div>
                            <button type="submit" class="btn btn-info text-white w-100 py-2">Kaydet</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white fw-bold py-3">👤 Rehber Ekle</div>
                    <div class="card-body p-4">
                        <form action="/add-guide" method="POST">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Rehber Adı</label>
                                <input type="text" name="guide_name" class="form-control" placeholder="Rehber Adı" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Telefon Numarası</label>
                                <input type="text" name="phone" class="form-control" placeholder="Telefon Numarası">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Email Adresi</label>
                                <input type="email" name="email" class="form-control" placeholder="Email Adresi">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Rehber Türü</label>
                                <select name="guide_type" class="form-select">
                                    <option value="GENERAL">Genel Tur Rehberi</option>
                                    <option value="LOCAL">Yerel Şehir Rehberi</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-warning text-white w-100 py-2">Kaydet</button>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>

</body>
</html>
