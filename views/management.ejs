<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OperationManagement - Definitions</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<nav class="navbar navbar-dark mb-5 shadow-sm" style="background-color: #10b981 !important;">
    <div class="container d-flex justify-content-between align-items-center">
        <span class="navbar-brand fw-bold fs-4 mb-0">🌐 OperationManagement</span>
        <a href="/calendar" class="btn btn-light btn-sm fw-bold"><i class="fa-solid fa-calendar-days me-1"></i> Takvim</a>
    </div>
</nav>

    <div class="container mb-5">
        <div class="row g-4">
            
            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white fw-bold py-3">📍 Add New Country</div>
                    <div class="card-body p-4">
                        <form action="/add-country" method="POST">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Country Name</label>
                                <input type="text" name="country_name" class="form-control" placeholder="e.g. Italy" required>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 py-2">Save Country</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white fw-bold py-3">🏙️ Add New City</div>
                    <div class="card-body p-4">
                        <form action="/add-city" method="POST">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Select Country</label>
                                <select name="country_id" class="form-select" required>
                                    <option value="">-- Choose Country --</option>
                                    <% countries.forEach(c => { %>
                                        <option value="<%= c.id %>"><%= c.country_name %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">City Name</label>
                                <input type="text" name="city_name" class="form-control" placeholder="e.g. Rome" required>
                            </div>
                            <button type="submit" class="btn btn-success w-100 py-2">Save City</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white fw-bold py-3">🏢 Add New Agency</div>
                    <div class="card-body p-4">
                        <form action="/add-agency" method="POST">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Agency Name</label>
                                <input type="text" name="agency_name" class="form-control" placeholder="e.g. Global Travel LLC" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Contact Info</label>
                                <input type="text" name="contact_info" class="form-control" placeholder="Phone or Email">
                            </div>
                            <button type="submit" class="btn btn-info text-white w-100 py-2">Save Agency</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white fw-bold py-3">👤 Add New Guide</div>
                    <div class="card-body p-4">
                        <form action="/add-guide" method="POST">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Guide Name</label>
                                <input type="text" name="guide_name" class="form-control" placeholder="e.g. John Doe" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Phone Number</label>
                                <input type="text" name="phone" class="form-control" placeholder="e.g. +90...">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Guide Type</label>
                                <select name="guide_type" class="form-select">
                                    <option value="GENERAL">General Tour Leader</option>
                                    <option value="LOCAL">Local City Guide</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-warning text-white w-100 py-2">Save Guide</button>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>

</body>
</html>
